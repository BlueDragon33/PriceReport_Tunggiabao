    "session": "No remote session in Standalone Mode; revocable KT session only in optional Managed Mode"
  },
  "readiness": {
    "runtime": "available",
    "deviceClassification": "available",
    "adaptiveUi": "available",
    "localDeviceRecord": "available",
    "deviceRegistry": "optional-managed-deployment",
    "deviceGateway": "optional-managed-deployment",
    "adminApi": "optional-managed-deployment",
    "remoteAuditApi": "optional-managed-deployment",
    "p256DeviceIdentity": "optional-managed-mode",
    "revocableSessions": "optional-managed-mode",
